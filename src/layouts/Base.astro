---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { phone, tel, email, services, areas } from '../data/site';
interface Props { title: string; description: string; active?: string }
const { title, description, active = '' } = Astro.props;
const nav: { label: string; href: string; key: string; children?: { label: string; href: string }[] }[] = [
  { label: 'Home', href: '/', key: 'home' },
  { label: 'Services', href: '/services/', key: 'services', children: [{ label: 'All services', href: '/services/' }, ...services] },
  { label: 'Areas', href: '/areas/glen-waverley/', key: 'areas', children: [...areas, { label: 'All service areas', href: '/#areas' }] },
  { label: 'About & Our Work', href: '/about/', key: 'about' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
  { label: 'Contact', href: '/contact/', key: 'contact' },
];
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#1b2328" />
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-copper focus:p-3 focus:text-white">Skip to content</a>
  <div class="bg-night text-[13px] text-stone-2">
    <div class="wrap flex min-h-9 items-center justify-between gap-4 py-2">
      <p class="truncate">Mulgrave-based · Installing across Melbourne's south-east since 2009 [sample]</p>
      <p class="hidden shrink-0 md:block">Mon–Fri 7:30–5 · Sat by appointment</p>
    </div>
  </div>
  <header class="sticky top-0 z-40 border-b border-line bg-white">
    <div class="wrap flex h-[72px] items-center justify-between gap-4 lg:h-[83px]">
      <Logo />
      <nav class="hidden items-center gap-6 xl:flex 2xl:gap-8" aria-label="Main">
        {nav.map((n) => n.children ? (
          <div class="group relative">
            <a href={n.href} class:list={['inline-flex items-center gap-1 py-3 text-[15px]', active === n.key ? 'font-bold underline underline-offset-[6px]' : 'font-medium hover:text-copper']} aria-haspopup="true">{n.label}<span class="text-[10px]">▾</span></a>
            <div class="invisible absolute left-0 top-full z-50 w-[300px] translate-y-1 rounded-[3px] border border-line bg-white py-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              {n.children.map((c) => <a href={c.href} class="block px-5 py-2.5 text-[15px] hover:bg-cream hover:text-copper">{c.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={n.href} class:list={['py-3 text-[15px]', active === n.key ? 'font-bold underline underline-offset-[6px]' : 'font-medium hover:text-copper']} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <div class="hidden items-center gap-5 whitespace-nowrap xl:flex 2xl:gap-7">
        <a href={tel} class="text-[17px] 2xl:text-[18px] font-bold">{phone}</a>
        <a href="/contact/#consult" class="btn btn-copper !min-h-[43px] !px-5 !text-[15px]">Book a Free In-Home Quote</a>
      </div>
      <div class="flex items-center gap-2 xl:hidden">
        <a href={tel} class="grid size-11 place-items-center rounded-[3px] bg-copper text-white" aria-label={`Call ${phone}`}><Icon name="phone" size={20} /></a>
        <button id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" class="grid size-11 place-items-center rounded-[3px] border border-line-2 text-ink" aria-label="Menu"><Icon name="menu" /></button>
      </div>
    </div>
    <nav id="mobile-nav" class="hidden max-h-[calc(100vh-72px)] overflow-y-auto border-t border-line bg-white xl:hidden" aria-label="Mobile">
      <div class="wrap flex flex-col py-3">
        {nav.map((n) => (
          <>
            <a href={n.href} class:list={['border-b border-line py-3 text-[17px]', active === n.key ? 'font-bold text-copper' : 'font-medium']}>{n.label}</a>
            {n.children && <div class="flex flex-col border-b border-line py-1 pl-4">{n.children.map((c) => <a href={c.href} class="py-2 text-[15px] text-muted">{c.label}</a>)}</div>}
          </>
        ))}
        <a href="/contact/#consult" class="btn btn-copper mt-4">Book a Free In-Home Quote</a>
        <a href={tel} class="btn btn-outline mt-2">Call {phone}</a>
      </div>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="bg-night text-white">
    <div class="wrap pt-[72px]">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[300px_1fr_1fr_1fr_1fr] lg:gap-12">
        <div class="sm:col-span-2 lg:col-span-1">
          <a href="/" class="font-display text-[28px]">Cooper &amp; Vale</a>
          <p class="mt-3 max-w-[300px] text-[14px] leading-relaxed text-stone">Ducted &amp; reverse cycle heating and cooling for Melbourne's south-east.</p>
          <a href={tel} class="mt-5 inline-block font-display text-[24px] text-peach">{phone}</a>
        </div>
        <div><h3 class="eyebrow !font-body !text-sand">Services</h3><ul class="mt-3 space-y-2.5 text-[14px] text-line-2">{services.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}</ul></div>
        <div><h3 class="eyebrow !font-body !text-sand">Areas</h3><ul class="mt-3 space-y-2.5 text-[14px] text-line-2">{areas.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}<li><a href="/#areas" class="hover:text-white">All service areas</a></li></ul></div>
        <div><h3 class="eyebrow !font-body !text-sand">Contact</h3><ul class="mt-3 space-y-2.5 text-[14px] text-line-2"><li>Unit 4, 18 Sample St, Mulgrave VIC 3170 [sample]</li><li><a href={`mailto:${email}`} class="break-all hover:text-white">{email}</a></li><li>Mon–Fri 7:30am–5pm</li></ul></div>
        <div><h3 class="eyebrow !font-body !text-sand">Licences</h3><ul class="mt-3 space-y-2.5 text-[14px] text-line-2"><li>Mechanical Services Plumber [sample]</li><li>ARC authorisation [sample]</li><li>Licensed gasfitter [sample]</li><li>$20M public liability [sample]</li></ul></div>
      </div>
      <div class="mt-14 flex flex-col gap-3 border-t border-white/10 py-6 md:flex-row md:items-center md:justify-between">
        <p class="text-[13px] font-semibold text-line-2">Demo site by AirLeads Builder. This business is fictional.</p>
        <p class="text-[13px] text-[#7d776c]">© 2026 Cooper &amp; Vale [sample] · <a href="/contact/" class="hover:text-white">Privacy</a></p>
      </div>
    </div>
  </footer>
  <script>
    const b = document.getElementById('menu-btn'), m = document.getElementById('mobile-nav');
    b?.addEventListener('click', () => { const o = m!.classList.toggle('hidden') === false; b.setAttribute('aria-expanded', String(o)); });
  </script>
</body>
</html>
