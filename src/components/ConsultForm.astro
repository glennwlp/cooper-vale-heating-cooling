---
import { phone, tel } from '../data/site';
import QuoteForm from './QuoteForm.astro';
interface Props { title?: string; id?: string }
const { title = "Let's look at your home properly.", id = 'consult' } = Astro.props;
---
<section class="bg-ink text-white" id={id}>
  <div class="wrap sec grid gap-12 lg:grid-cols-[1fr_560px] lg:gap-20">
    <div>
      <p class="eyebrow !text-sand">Free in-home consult</p>
      <h2 class="h2 mt-3 max-w-[632px]">{title}</h2>
      <p class="mt-6 max-w-[632px] text-[17px] leading-relaxed text-stone-3">Tell us a little about the house and we'll call within one business day to book a time. No obligation, no hard sell.</p>
      <p class="eyebrow mt-9 !text-stone">What happens next</p>
      <ol class="mt-3 max-w-[632px]">
        {['We call to book a time that suits', 'We visit, measure and check the roof space', 'You get Good / Better / Best options in writing'].map((s, i) => (
          <li class="flex gap-4 border-b border-white/15 py-3 text-[16px]"><span class="font-display text-[18px] text-sand">{i + 1}</span>{s}</li>
        ))}
      </ol>
      <a href={tel} class="mt-9 inline-block font-display text-[24px] text-peach hover:underline sm:text-[26px]">Rather talk it through? {phone}</a>
    </div>
    <QuoteForm id={id} />
  </div>
</section>
