---
import { tel, phone } from '../data/site';
interface Props { title: string; items: [string, string][] }
const { title, items } = Astro.props;
---
<section class="bg-white">
  <div class="wrap sec grid gap-10 lg:grid-cols-[380px_1fr] lg:gap-24">
    <div><p class="eyebrow">Questions</p><h2 class="h2 mt-3">{title}</h2><p class="mt-6 text-[16px] leading-relaxed text-muted">Something else? Call <a href={tel} class="underline">{phone}</a> and ask for a designer, not a salesperson.</p></div>
    <div class="faq border-t border-ink">
      {items.map(([q, a], i) => (
        <details class="border-b border-line-2" open={i === 0}>
          <summary class="flex items-start justify-between gap-6 py-6"><span class="font-display text-[20px] sm:text-[22px]">{q}</span><span class="pm text-[24px] leading-none text-copper" aria-hidden="true"></span></summary>
          <p class="-mt-2 max-w-[804px] pb-6 text-[16px] leading-relaxed text-muted">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
