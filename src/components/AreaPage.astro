---
import Base from '../layouts/Base.astro';
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import TrustStrip from './TrustStrip.astro';
import ConsultForm from './ConsultForm.astro';
import type { Area } from '../data/areas';
interface Props { a: Area }
const { a } = Astro.props;
const svc = [
  ['Ducted reverse cycle', '/services/ducted-reverse-cycle/'], ['Split systems & reverse cycle heating', '/services/split-systems-reverse-cycle-heating/'],
  ['Gas to reverse cycle upgrades', '/services/#gas-upgrades'], ['Servicing & maintenance plans', '/services/servicing-maintenance-plans/'],
];
---
<Base title={`Ducted & Reverse Cycle Heating and Cooling in ${a.name} | Cooper & Vale`} description={`Local ducted and reverse cycle heating and cooling in ${a.name} ${a.postcode}. Free in-home consult from our Mulgrave team.`} active="areas">
  <PageHero crumbs={[['Home', '/'], ['Areas', '/#areas'], [a.name]]} title={`Ducted & Reverse Cycle Heating and Cooling in ${a.name}`} lead={a.lead} image={a.image} alt={a.imageAlt} stats={a.stats} />
  <TrustStrip />
  <section class="bg-white">
    <div class="wrap sec grid gap-12 lg:grid-cols-[minmax(0,764px)_minmax(280px,1fr)] lg:gap-12 xl:gap-24">
      <div>
        <p class="eyebrow">Heating &amp; cooling in {a.name} {a.postcode}</p>
        <h2 class="h2 mt-3">{a.heading}</h2>
        <p class="lead mt-6">{a.intro[0]}</p>
        <p class="lead mt-4">{a.intro[1]}</p>
      </div>
      <dl class="self-start border-t border-ink">
        {a.facts.map(([k, v]) => <div class="flex justify-between gap-4 border-b border-line py-3.5"><dt class="text-[14px] text-muted">{k}</dt><dd class="text-right text-[15px] font-semibold">{v}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="bg-cream">
    <div class="wrap sec">
      <p class="eyebrow">Typical {a.name} homes</p>
      <h2 class="h2 mt-3 max-w-[760px]">What we usually recommend, by house type.</h2>
      <ul class="mt-12 grid gap-10 md:grid-cols-3">
        {a.homes.map(([t, d, u]) => <li><Icon name="home" size={22} class="text-copper" /><div class="mt-4 border-t border-line-2 pt-5"><h3 class="text-[26px]">{t}</h3><p class="mt-3 text-[15px] leading-relaxed text-muted">{d}</p><p class="mt-4 inline-block rounded-[2px] bg-mint px-3 py-1.5 text-[13px] font-bold text-teal-dark">Usually: {u}</p></div></li>)}
      </ul>
    </div>
  </section>
  <section class="bg-white">
    <div class="wrap sec">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div><p class="eyebrow">Recent work nearby</p><h2 class="h2 mt-3 max-w-[700px]">Sample jobs in and around {a.name}.</h2></div>
        <a href="/about/#work" class="link-arrow shrink-0">See all our work&nbsp; →</a>
      </div>
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {a.jobs.map(([im, t, d]) => <li><Pic name={im} alt={`${t} (sample imagery)`} class="aspect-[41/30] w-full" sizes="(min-width:768px) 410px, 100vw" /><h3 class="mt-4 text-[21px]">{t}</h3><p class="mt-1 text-[14px] text-muted">{d}</p></li>)}
      </ul>
    </div>
  </section>
  <section class="bg-ink-2 text-white">
    <div class="wrap sec grid gap-12 lg:grid-cols-[minmax(0,760px)_minmax(280px,1fr)] lg:gap-12 xl:gap-20">
      <div>
        <p class="eyebrow !text-sand">Services in {a.name}</p>
        <ul class="mt-4">{svc.map(([l, h]) => <li class="border-b border-white/15"><a href={h} class="flex items-center justify-between gap-4 py-4 font-display text-[19px] hover:text-peach sm:text-[21px]">{l} in {a.name}<span class="font-body text-[18px] text-sand">→</span></a></li>)}</ul>
      </div>
      <div>
        <p class="eyebrow !text-sand">Also servicing nearby</p>
        <ul class="mt-4 flex flex-wrap gap-2">{a.nearby.map((s) => <li class="rounded-[2px] border border-white/25 px-3 py-2 text-[14px] font-medium">{s}</li>)}</ul>
        <blockquote class="mt-8 font-display text-[22px] leading-snug">“{a.quote}”</blockquote>
        <p class="mt-3 text-[13px] text-stone">— Sample customer, {a.name}</p>
      </div>
    </div>
  </section>
  <ConsultForm title={`Book a free consult in ${a.name}.`} />
</Base>
