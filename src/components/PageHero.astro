---
import Pic from './Pic.astro';
import { tel, phone } from '../data/site';
interface Props { crumbs: [string, string?][]; title: string; lead: string; image: string; alt: string; stats?: [string, string][]; ctaHref?: string }
const { crumbs, title, lead, image, alt, stats = [], ctaHref = '#consult' } = Astro.props;
---
<section class="bg-ink text-white">
  <div class="mx-auto grid max-w-[1440px] lg:grid-cols-[1fr_620px] xl:grid-cols-[820px_620px]">
    <div class="wrap !mx-0 py-14 lg:py-[72px] lg:!pr-10">
      <nav aria-label="Breadcrumb" class="text-[13px] text-stone">
        {crumbs.map(([l, h], i) => <>{i > 0 && <span class="mx-2">/</span>}{h ? <a href={h} class="hover:text-white">{l}</a> : <span aria-current="page">{l}</span>}</>)}
      </nav>
      <h1 class="h1 mt-5 max-w-[668px] text-[clamp(36px,4.8vw,60px)]">{title}</h1>
      <p class="mt-5 max-w-[668px] text-[17px] leading-relaxed text-stone-3 sm:text-[19px]">{lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={ctaHref} class="btn btn-copper">Book a Free In-Home Quote <span aria-hidden="true">→</span></a>
        <a href={tel} class="btn btn-ghost">Call {phone}</a>
      </div>
      {stats.length > 0 && (
        <dl class="mt-9 flex flex-wrap gap-x-12 gap-y-5 border-t border-white/15 pt-6">
          {stats.map(([v, l]) => <div><dt class="sr-only">{l}</dt><dd class="font-display text-[28px] leading-none text-peach">{v}</dd><dd class="mt-2 text-[13px] text-stone">{l}</dd></div>)}
        </dl>
      )}
    </div>
    <Pic name={image} alt={alt} eager class="min-h-[300px] sm:min-h-[420px] lg:min-h-full" sizes="(min-width:1024px) 620px, 100vw" />
  </div>
</section>
