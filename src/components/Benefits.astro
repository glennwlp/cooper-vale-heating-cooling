---
import Icon from './Icon.astro';
interface Props { title: string; items: [string, string, string][] }
const { title, items } = Astro.props;
---
<section class="bg-white">
  <div class="wrap sec">
    <p class="eyebrow">Why it works</p>
    <h2 class="h2 mt-3 max-w-[760px]">{title}</h2>
    <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {items.map(([ic, t, d]) => <li><Icon name={ic} size={24} class="text-copper" /><div class="mt-4 border-t border-line-2 pt-5"><h3 class="text-[24px]">{t}</h3><p class="mt-3 text-[15px] leading-relaxed text-muted">{d}</p></div></li>)}
    </ul>
  </div>
</section>
