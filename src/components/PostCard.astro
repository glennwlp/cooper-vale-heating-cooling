---
import Pic from './Pic.astro';
interface Props { p: readonly string[]; small?: boolean }
const { p, small } = Astro.props;
const [im, cat, t, d, meta] = p;
---
<a href={`/blog/${p[5]}/`} class="group block"><article>
  <Pic name={im} alt={`${t} (sample imagery)`} class={small ? 'aspect-[5/3] w-full' : 'aspect-[20/13] w-full'} sizes="(min-width:768px) 400px, 100vw" widths={[400, 800]} />
  <p class="mt-5 text-[12px] font-semibold tracking-[0.08em] text-teal-dark uppercase">{cat}</p>
  <h3 class={`mt-2 group-hover:text-copper-dark ${small ? 'text-[22px]' : 'text-[24px]'}`}>{t}</h3>
  {!small && <p class="mt-2 text-[15px] leading-relaxed text-muted">{d}</p>}
  <p class="mt-3 text-[13px] text-muted">{meta}</p>
</article></a>
