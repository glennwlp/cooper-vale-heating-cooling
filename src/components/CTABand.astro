---
import { tel, phone } from '../data/site';
interface Props { title: string; sub: string; href?: string }
const { title, sub, href = '/contact/#consult' } = Astro.props;
---
<section class="bg-copper text-white">
  <div class="wrap flex flex-col gap-8 py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-[760px]"><h2 class="text-[clamp(30px,3.4vw,44px)]">{title}</h2><p class="mt-4 text-[17px] text-blush sm:text-[18px]">{sub}</p></div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:w-[300px] lg:flex-col [&_.btn]:whitespace-nowrap">
      <a href={href} class="btn btn-ink">Book a Free In-Home Quote <span aria-hidden="true">→</span></a>
      <a href={tel} class="btn btn-ghost">Call {phone}</a>
    </div>
  </div>
</section>
