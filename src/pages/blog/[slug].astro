---
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import PostCard from '../../components/PostCard.astro';
import CTABand from '../../components/CTABand.astro';
import Share from '../../components/Share.astro';
import { posts, featured } from '../../data/posts';
import { bodies } from '../../data/postBodies';
import { tel, phone } from '../../data/site';
export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post[5] }, props: { post } }));
}
const { post } = Astro.props;
const [im, cat, title, excerpt, meta, slug] = post;
const b = bodies[slug];
const [an, ai, ar] = b.author;
const all = [featured, ...posts].filter((x) => x[5] !== slug);
const i0 = posts.findIndex((x) => x[5] === slug);
const more = [0, 1, 2].map((k) => all[(i0 + k) % all.length]);
const p = 'text-[17px] leading-[1.7] text-[#2f3a40] sm:text-[18px]';
const mid = Math.floor(b.sections.length / 2);
---
<Base title={`${title} | Cooper & Vale`} description={excerpt} active="blog">
  <article>
    <header class="bg-cream">
      <div class="wrap pt-12 lg:pt-16">
        <div class="max-w-[880px]">
          <nav aria-label="Breadcrumb" class="text-[13px] text-muted"><a href="/" class="hover:text-ink">Home</a><span class="mx-2">/</span><a href="/blog/" class="hover:text-ink">Blog</a><span class="mx-2">/</span><span aria-current="page">{cat}</span></nav>
          <p class="mt-6 text-[12px] font-semibold tracking-[0.08em] text-teal-dark uppercase">{cat}</p>
          <h1 class="mt-3 text-[36px] leading-[1.1] sm:text-[56px]">{title}</h1>
          <p class="mt-5 text-[18px] leading-relaxed text-muted sm:text-[20px]">{excerpt}</p>
          <div class="mt-8 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3"><span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink font-display text-[16px] text-peach">{ai}</span><div><p class="text-[15px] font-bold">{an}</p><p class="text-[13px] text-muted">{ar}  ·  {meta}</p></div></div>
            <Share />
          </div>
        </div>
        <Pic name={im} alt={`${title} (sample imagery)`} class="mt-10 aspect-[32/15] w-full" sizes="(min-width:1440px) 1280px, 100vw" widths={[640, 1280, 1920]} eager />
      </div>
    </header>
    <div class="bg-cream">
      <div class="wrap grid gap-12 py-14 lg:grid-cols-[260px_minmax(0,760px)] min-[1440px]:grid-cols-[316px_760px] lg:gap-20 lg:py-20">
        <aside class="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow">In this article</p>
          <ol class="mt-4 border-t border-line">{b.sections.map((s, i) => <li class="border-b border-line"><a href={`#${s.id}`} class="flex gap-3 py-3 text-[14px] font-medium hover:text-copper-dark"><span class="text-[13px] text-copper">0{i + 1}</span>{s.h}</a></li>)}</ol>
          <div class="mt-8 rounded-[2px] bg-ink p-6 text-white">
            <p class="font-display text-[22px] leading-snug">{b.tip[0]}</p>
            <p class="mt-2 text-[14px] text-stone-2">{b.tip[1]}</p>
            <a href="/contact/#consult" class="btn btn-copper btn-sm mt-5 w-full">Book a Free Consult</a>
            <a href={tel} class="mt-3 block text-center text-[13px] text-peach">or call {phone}</a>
          </div>
        </aside>
        <div class="min-w-0">
          <p class="font-display text-[21px] leading-snug sm:text-[24px]">{b.intro}</p>
          {b.sections.map((s, i) => (
            <>
              {i === mid && <blockquote class="mt-10 border-l-[3px] border-copper pl-6"><p class="font-display text-[24px] leading-snug sm:text-[28px]">“{b.quote[0]}”</p><footer class="mt-3 text-[14px] text-muted">— {b.quote[1]}</footer></blockquote>}
              <h2 id={s.id} class="mt-12 scroll-mt-28 text-[28px] sm:text-[32px]">{s.h}</h2>
              {s.p.map((t) => <p class={`mt-4 ${p}`}>{t}</p>)}
              {s.list && <ul class="mt-6 space-y-3">{s.list.map((l) => <li class="flex gap-3 text-[17px]"><span class="mt-2.5 size-2 shrink-0 rounded-full bg-copper"></span>{l}</li>)}</ul>}
            </>
          ))}
          <div class="mt-10 flex flex-col gap-4 border-y border-line py-5 sm:flex-row sm:items-center sm:justify-between"><p class="text-[15px] text-muted">Found this useful? Share it with someone weighing up the same decision.</p><Share /></div>
          <div class="mt-8 flex gap-5 bg-white p-6 sm:p-8"><span class="grid size-14 shrink-0 place-items-center rounded-full bg-ink font-display text-[22px] text-peach">{ai}</span><div><p class="font-display text-[22px]">Written by {an}</p><p class="mt-2 text-[15px] leading-relaxed text-muted">{b.bio}</p></div></div>
        </div>
      </div>
    </div>
  </article>
  <section class="bg-white">
    <div class="wrap sec">
      <div class="flex items-end justify-between gap-4"><h2 class="h2">Keep reading</h2><a href="/blog/" class="link-arrow shrink-0">All articles&nbsp; →</a></div>
      <div class="mt-10 grid gap-10 md:grid-cols-3">{more.map((x) => <PostCard p={x} small />)}</div>
    </div>
  </section>
  <CTABand title="Rather talk it through with a designer?" sub="Free in-home consult. Three written options. No pressure." />
</Base>
