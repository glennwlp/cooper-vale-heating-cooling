---
interface Tier { price: string; sub: string; vals: string[] }
interface Props { title: string; lead: string; rows: string[]; tiers: [Tier, Tier, Tier] }
const { title, lead, rows, tiers } = Astro.props;
const names = [['Good', 'text-steel'], ['Better · most chosen', 'text-teal'], ['Best', 'text-copper']];
---
<section class="bg-ink-2 text-white">
  <div class="wrap sec">
    <div class="grid gap-6 lg:grid-cols-[1fr_560px] lg:items-end">
      <div><p class="eyebrow !text-sand">Investment guide</p><h2 class="h2 mt-3 max-w-[640px]">{title}</h2></div>
      <p class="text-[17px] leading-relaxed text-stone-2">{lead}</p>
    </div>
    <div class="mt-12 overflow-hidden rounded-[2px] bg-cream text-ink">
      <div class="grid lg:grid-cols-[308px_1fr_1fr_1fr]">
        <div class="hidden lg:block"><div class="h-[142px]"></div>{rows.map((r) => <p class="flex h-[57px] items-center border-t border-line px-8 text-[14px] font-bold">{r}</p>)}</div>
        {tiers.map((t, i) => (
          <div class:list={['flex flex-col border-t border-line lg:border-t-0', i === 1 ? 'bg-white lg:border-x-2 lg:border-teal' : '']}>
            <div class="px-6 pt-8 lg:h-[142px] lg:px-8">
              <span class:list={['block h-[3px] w-6', i === 0 ? 'bg-steel' : i === 1 ? 'bg-teal' : 'bg-copper']}></span>
              <p class:list={['mt-3 text-[14px] font-bold', names[i][1]]}>{names[i][0]}</p>
              <p class="mt-1 font-display text-[40px] leading-tight">{t.price}</p>
              <p class="text-[14px] text-muted">{t.sub}</p>
            </div>
            <dl class="mt-4 lg:mt-0">
              {t.vals.map((v, j) => <div class="flex min-h-[57px] items-center justify-between gap-4 border-t border-line px-6 text-[15px] lg:block lg:px-8 lg:py-0 lg:leading-[57px]"><dt class="text-[13px] font-bold lg:sr-only">{rows[j]}</dt><dd class:list={['text-right lg:text-left', v === '—' && 'text-stone']}>{v}</dd></div>)}
            </dl>
            <div class="px-6 pt-4 pb-8 lg:px-8"><a href="#consult" class:list={['btn btn-sm w-full', i === 1 ? 'btn-teal' : 'btn-outline']}>Quote this option</a></div>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-8 text-[13px] text-stone">Prices are [sample] guides for a typical 3–4 bedroom south-east home. Your written quote follows the in-home consult.</p>
  </div>
</section>
